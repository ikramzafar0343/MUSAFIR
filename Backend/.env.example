NODE_ENV=production
# Public site — musafir.com on Hostinger VPS
APP_URL=https://musafir.com
API_HOST=0.0.0.0
API_PORT=5000
API_PREFIX=/api/v1

# Postgres on the VPS (replace USER/PASSWORD after creating the DB)
DATABASE_URL=postgresql://musafir:CHANGE_ME@127.0.0.1:5432/musafir
DATABASE_MIGRATE_URL=postgresql://musafir:CHANGE_ME@127.0.0.1:5432/musafir
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000

# Generate long random strings for production (do not reuse these placeholders)
HMAC_SIGNING_SECRET=replace-with-64-char-hmac-signing-secret-value-not-a-real-secret
SESSION_SECRET=replace-with-64-char-session-secret-value-not-a-real-secret

SESSION_TTL_SECONDS=604800
NONCE_TTL_SECONDS=600
HMAC_TIMESTAMP_WINDOW_SECONDS=300

RATE_LIMIT_CAPACITY=400
RATE_LIMIT_REFILL_PER_SECOND=2

CORS_ORIGIN=https://musafir.com,https://www.musafir.com
SUPPORT_EMAIL=sales@musafir.com
EMAIL_FROM=MUSAFIR <sales@musafir.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

WHATSAPP_PROVIDER=auto
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

UPLOAD_MAX_FILE_SIZE=41943040
UPLOAD_DIR=../Frontend/public/uploads
STORAGE_PROVIDER=local

# Admin Tools → Background remover uses @imgly/background-removal-node locally (ONNX).
# No API key required. First run downloads model weights (~40–80MB) from IMG.LY CDN
# (or host them yourself via the package's publicPath). Hard input cap is 12MB / ~25MP.
# Optional future cloud adapter (unused in V1 — do not set unless you add a remove.bg provider):
# REMOVE_BG_API_KEY=

# On API start, a published hero that is still a plain /uploads clip is converted once
# (in the background) to the transparent cutout. Set to 0 to disable.
# PRERENDER_HERO_ON_START=0

# Set these on the VPS before `npm run seed` (never commit real passwords to public forks)
SEED_ADMIN_EMAIL=admin@musafir.com
SEED_ADMIN_PASSWORD=Musafir@0343
SEED_ADMIN_NAME=MUSAFIR Admin
ADMIN_PASSCODE=0343
