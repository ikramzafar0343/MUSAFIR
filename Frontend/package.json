{
  "name": "musafir-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "test": "node scripts/run-tests.mjs && npm run test:unit",
    "test:unit": "tsx --test src/lib/hero-video.test.ts src/constants/commerce.test.ts src/schemas/order.test.ts",
    "audit": "npm audit --audit-level=high",
    "deps:circular": "depcruise src --config dependency-cruiser.cjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.33.0",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
